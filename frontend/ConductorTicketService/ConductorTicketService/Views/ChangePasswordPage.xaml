<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:ConductorTicketService.ViewModels"
             x:DataType="viewModels:IChangePasswordViewModel"
             x:Class="ConductorTicketService.Views.ChangePasswordPage"
             Title="Wachtwoord wijzigen">
    <!-- ScrollView: with the keyboard open, this form can be taller than the screen. -->
    <ScrollView>
        <VerticalStackLayout Spacing="10" Padding="20">
            <Entry Placeholder="Huidig wachtwoord"
                   Text="{Binding CurrentPassword}"
                   IsPassword="True" />

            <Entry Placeholder="Nieuw wachtwoord"
                   Text="{Binding NewPassword}"
                   IsPassword="True" />

            <Entry Placeholder="Nieuw wachtwoord bevestigen"
                   Text="{Binding ConfirmNewPassword}"
                   IsPassword="True" />

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasErrorMessage}"
                   TextColor="Red" />

            <Label Text="{Binding SuccessMessage}"
                   IsVisible="{Binding HasSuccessMessage}"
                   TextColor="Green" />

            <Button Text="Wachtwoord wijzigen" Command="{Binding ChangePasswordCommand}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
