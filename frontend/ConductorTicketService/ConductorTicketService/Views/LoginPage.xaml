<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:ConductorTicketService.ViewModels"
             x:DataType="viewModels:ILoginViewModel"
             x:Class="ConductorTicketService.Views.LoginPage"
             Shell.NavBarIsVisible="False">
    <VerticalStackLayout Spacing="10" Padding="20" VerticalOptions="Center">
        <Label Text="Inloggen als conducteur" FontSize="24" HorizontalOptions="Center" />

        <!-- Keyboard="Email" shows a keyboard with @ and doesn't capitalize the first letter.
             Spell check and text prediction are off so the keyboard doesn't "correct" the address. -->
        <Entry Placeholder="E-mail"
               Text="{Binding Email}"
               Keyboard="Email"
               IsSpellCheckEnabled="False"
               IsTextPredictionEnabled="False" />

        <Entry Placeholder="Wachtwoord"
               Text="{Binding Password}"
               IsPassword="True" />

        <Label Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasErrorMessage}"
               TextColor="Red" />

        <!-- AsyncRelayCommand disables the button by itself while the login is running. -->
        <Button Text="Inloggen" Command="{Binding LoginCommand}" />

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <Button Text="Nog geen account? Registreren"
                Command="{Binding NavigateToRegisterCommand}"
                BackgroundColor="Transparent"
                TextColor="{StaticResource Primary}" />
    </VerticalStackLayout>
</ContentPage>
