<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:ConductorTicketService.ViewModels"
             x:DataType="viewModels:IScanListViewModel"
             x:Class="ConductorTicketService.Views.ScanListPage">
    <VerticalStackLayout Spacing="10" Padding="20">
        <Button Text="Scan QR Code" Command="{Binding ScanQrCodeCommand}" />
        <Button Text="Scan Face" />
        <Button Text="Scan Id" />
    </VerticalStackLayout>
</ContentPage>