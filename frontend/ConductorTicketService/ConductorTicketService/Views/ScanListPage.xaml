<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:ConductorTicketService.ViewModels"
             x:DataType="viewModels:IScanListViewModel"
             x:Class="ConductorTicketService.Views.ScanListPage">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Account" Command="{Binding AccountCommand}" />
        <ToolbarItem Text="Uitloggen" Command="{Binding LogoutCommand}" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Spacing="10" Padding="20">
        <Button Text="QR-code scannen" Command="{Binding ScanQrCodeCommand}" />
        <Button Text="Gezicht scannen" Command="{Binding ScanFaceCommand}" />
    </VerticalStackLayout>
</ContentPage>