<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:ConductorTicketService.ViewModels"
             x:DataType="viewModels:IRegisterViewModel"
             x:Class="ConductorTicketService.Views.RegisterPage"
             Title="Registreren">
    <!-- ScrollView: with the keyboard open, this form is taller than the screen. -->
    <ScrollView>
        <VerticalStackLayout Spacing="10" Padding="20" VerticalOptions="Center">
            <Label Text="Conducteur registreren" FontSize="24" HorizontalOptions="Center" />

            <Entry Placeholder="Voornaam"
                   Text="{Binding FirstName}" />

            <Entry Placeholder="Familienaam"
                   Text="{Binding Surname}" />

            <!-- Same settings as on the login page, so the keyboard doesn't "correct" the address. -->
            <Entry Placeholder="E-mail"
                   Text="{Binding Email}"
                   Keyboard="Email"
                   IsSpellCheckEnabled="False"
                   IsTextPredictionEnabled="False" />

            <Entry Placeholder="Wachtwoord"
                   Text="{Binding Password}"
                   IsPassword="True" />

            <Entry Placeholder="Wachtwoord bevestigen"
                   Text="{Binding ConfirmPassword}"
                   IsPassword="True" />

            <!-- In real life this code would come in the invite email. -->
            <Entry Placeholder="Registratiecode"
                   Text="{Binding RegistrationCode}"
                   IsSpellCheckEnabled="False"
                   IsTextPredictionEnabled="False" />

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasErrorMessage}"
                   TextColor="Red" />

            <Button Text="Account aanmaken" Command="{Binding RegisterCommand}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button Text="Al een account? Inloggen"
                    Command="{Binding NavigateToLoginCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
