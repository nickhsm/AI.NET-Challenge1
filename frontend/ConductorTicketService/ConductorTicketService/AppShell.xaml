<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ConductorTicketService.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ConductorTicketService.Views"
    Title="ConductorTicketService"
    FlyoutBehavior="Disabled">

    <!-- The first ShellContent is shown when the app starts, so the login page comes first.
         FlyoutBehavior="Disabled" hides the menu, otherwise you could open "Home" without logging in. -->
    <ShellContent
        Title="Inloggen"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        Title="Start"
        ContentTemplate="{DataTemplate views:ScanListPage}"
        Route="MainPage" />

</Shell>
