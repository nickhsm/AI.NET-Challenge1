<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PassengerTicketService.ViewModels"
             x:Class="PassengerTicketService.Views.ProfilePage"
             x:DataType="viewModels:IProfileViewModel"
             BackgroundColor="#101010"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- 1. HEADER -->
        <Grid Grid.Row="0" Padding="20,40,20,20" ColumnDefinitions="*, Auto">

            <!-- Gebruikersinfo -->
            <VerticalStackLayout Grid.Column="0" Spacing="5">
                <!-- Naam -->
                <Label Text="{Binding UserName}" TextColor="White" FontAttributes="Bold" FontSize="18" />
            </VerticalStackLayout>

            <!-- Uitloggen Knop (Wit met tekst en SVG) -->
            <Border Grid.Column="1" BackgroundColor="White" HeightRequest="40" Padding="15,0" VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                </Border.GestureRecognizers>

                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Log uit" TextColor="Black" FontAttributes="Bold" FontSize="14" VerticalOptions="Center" />
                    <!-- Logout Icoon (SVG pijltje uit deur) -->
                    <Path Data="M16,17V14H9V10H16V7L21,12L16,17M14,2A2,2 0 0,1 16,4V6H14V4H5V20H14V18H16V20A2,2 0 0,1 14,22H5A2,2 0 0,1 3,20V4A2,2 0 0,1 5,2H14Z"
                          Fill="Black" Aspect="Uniform" WidthRequest="16" HeightRequest="16"
                          VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- 2. CONTENT -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,10,20,20" Spacing="15">

                <!-- App-instellingen Titel -->
                <Label Text="App-instellingen" TextColor="#A0A0A0" FontSize="16" FontAttributes="Bold" Margin="5,10,0,5" />

                <!-- Instellingen Kaart -->
                <Border BackgroundColor="#1E1E1E" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout>

                        <!-- Item 1: Bewerk account gegevens -->
                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="15,20">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding EditAccountCommand}" />
                            </Grid.GestureRecognizers>
                            <Path Grid.Column="0" 
                                  Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                  Fill="White" Aspect="Uniform" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" Margin="0,0,15,0"/>
                            <Label Grid.Column="1" Text="Bewerk account gegevens" TextColor="White" FontSize="16" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" TextColor="#A0A0A0" FontSize="24" VerticalOptions="Center" />
                        </Grid>

                        <BoxView Color="#2B2B2B" HeightRequest="1" Margin="15,0" />

                        <!-- Item 2: Gezichtsherkenning toevoegen -->
                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="15,20">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddFaceIdCommand}" />
                            </Grid.GestureRecognizers>
                            <Path Grid.Column="0" 
                                  Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"
                                  Fill="White" Aspect="Uniform" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" Margin="0,0,15,0"/>
                            <Label Grid.Column="1" Text="Gezichtsherkenning toevoegen" TextColor="White" FontSize="16" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" TextColor="#A0A0A0" FontSize="24" VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 3. NAVIGATIEBALK (Jouw aangeleverde code) -->
        <Grid Grid.Row="2" VerticalOptions="End" Margin="0,20,0,0">

            <!-- Background Bar -->
            <Border BackgroundColor="#1C1C1E" StrokeThickness="0" HeightRequest="70" VerticalOptions="End">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="25,25,0,0" />
                </Border.StrokeShape>

                <!-- Nav Icons -->
                <Grid ColumnDefinitions="*, *, *" Padding="10,0">
                    <!-- Home-ikoon → navigates to the Home-page -->
                    <Grid Grid.Column="0" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" VerticalOptions="Center">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateHomeCommand}" />
                        </Grid.GestureRecognizers>
                        <Path Data="M10,20 L10,14 L14,14 L14,20 L19,20 L19,12 L22,12 L12,3 L2,12 L5,12 L5,20 Z"
                              Fill="White" Aspect="Uniform" WidthRequest="24" HeightRequest="24"
                              HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>

                    <!-- Empty space for FAB -->
                    <BoxView Grid.Column="1" Color="Transparent" BackgroundColor="Transparent"/>

                    <!-- Profile / user-page (Actief, blauw) -->
                    <Grid Grid.Column="2" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" VerticalOptions="Center">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateProfileCommand}" />
                        </Grid.GestureRecognizers>
                        <Path Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z"
                              Fill="#5AA2F0" Aspect="Uniform" WidthRequest="24" HeightRequest="24"
                              HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Floating Action Button (Orange) → navigates to the Ticket-page -->
            <Border BackgroundColor="#E86A22" StrokeThickness="0" WidthRequest="65" HeightRequest="65" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,-35,0,0" ZIndex="1">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateTicketsCommand}" />
                </Border.GestureRecognizers>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="32.5" />
                </Border.StrokeShape>
                <Path Data="M22,10 L22,6 C22,4.9 21.1,4 20,4 L4,4 C2.9,4 2.01,4.9 2.01,6 L2,10 C3.1,10 4,10.9 4,12 C4,13.1 3.1,14 2,14 L2,18 C2,19.1 2.9,20 4,20 L20,20 C21.1,20 22,19.1 22,18 L22,14 C20.9,14 20,13.1 20,12 C20,10.9 20.9,10 22,10 Z"
                      Fill="White" Aspect="Uniform" WidthRequest="28" HeightRequest="28"
                      HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>
    </Grid>
</ContentPage>