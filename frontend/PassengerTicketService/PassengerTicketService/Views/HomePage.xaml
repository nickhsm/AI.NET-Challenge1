<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PassengerTicketService.Views.HomePage"
             xmlns:viewModels="clr-namespace:PassengerTicketService.ViewModels"
             x:DataType="viewModels:IHomeViewModel"
             BackgroundColor="#101010"
             Shell.NavBarIsVisible="False"
             Title="HomePage">

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <!-- 1. Top Section: Header and Tabs -->
        <VerticalStackLayout Grid.Row="0" Padding="20,40,20,15" Spacing="15">
            <Label Text="Wat zoek je?" 
                TextColor="White" 
                FontSize="26" 
                FontAttributes="Bold" />
        </VerticalStackLayout>

        <!-- 2. Middle Section: Search Card -->
        <Border Grid.Row="1" 
            Margin="20,0,20,0" 
            BackgroundColor="#2B2B2B" 
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto, Auto, Auto">

                <!-- Van / Naar Section -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="15,20,15,15">

                    <!-- Input Fields -->
                    <VerticalStackLayout Grid.Column="0" Spacing="10">
                        <Label Text="Van:" TextColor="#A0A0A0" FontSize="14" />

                        <Grid VerticalOptions="Center">
                            <!-- Bind aan StartStation -->
                            <Entry Placeholder="station, halte of adres" 
                                   Text="{Binding StartStation}" 
                                   TextColor="White" 
                                   PlaceholderColor="#888888"
                                   HorizontalOptions="Fill"/>
                        </Grid>

                        <Label Text="Naar:" TextColor="#A0A0A0" FontSize="14" Margin="0,5,0,0" />

                        <Grid VerticalOptions="Center">
                            <!-- Bind aan EndStation -->
                            <Entry Placeholder="station, halte of adres" 
                                   Text="{Binding EndStation}" 
                                   TextColor="White"
                                   PlaceholderColor="#888888"
                                   HorizontalOptions="Fill"/>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Swap Button -->
                    <Border Grid.Column="1" 
                        BackgroundColor="#5AA2F0" 
                        WidthRequest="50" 
                        HeightRequest="50" 
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="25" />
                        </Border.StrokeShape>

                        <!-- Maak de knop klikbaar -->
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SwapStationsCommand}" />
                        </Border.GestureRecognizers>

                        <!-- Vervang de emoji door een SVG -->
                        <Path Data="M9,3L5,7H8V14H10V7H13M16,17V10H14V17H11L15,21L19,17H16Z"
                          Fill="Black" 
                          Aspect="Uniform" 
                          WidthRequest="24" 
                          HeightRequest="24" 
                          HorizontalOptions="Center" 
                          VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Departure & Filters Section -->
                <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Padding="15,0,15,15">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Vertrek:" TextColor="#A0A0A0" FontSize="14" />
                        <HorizontalStackLayout Spacing="8">
                            <!-- Calendar Icon placeholder -->
                            <Path Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z"
                              Fill="#5AA2F0" 
                              Aspect="Uniform" 
                              WidthRequest="18" 
                              HeightRequest="18" 
                              VerticalOptions="Center" />
                            <Label Text="vandaag" TextColor="White" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Filters Button -->
                    <Border Grid.Column="1" BackgroundColor="#5AA2F0" Padding="12,8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="⚙" TextColor="Black" FontSize="16" VerticalOptions="Center" />
                            <Label Text="Selecteer Datum" TextColor="Black" FontAttributes="Bold" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- Zoeken Button -->
                <Button Grid.Row="2" 
                    Text="Kopen" 
                    Command="{Binding BuyTicketCommand}" 
                    BackgroundColor="#E86A22" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    FontSize="18" 
                    CornerRadius="0" 
                    HeightRequest="55" />
            </Grid>
        </Border>

        <!-- 4. Bottom Navigation Bar -->
        <!-- We use a Grid to allow the pink FAB to overlap the top edge of the nav bar -->
        <Grid Grid.Row="3" VerticalOptions="End" Margin="0,20,0,0">

            <!-- Background Bar -->
            <Border BackgroundColor="#1C1C1E" 
                StrokeThickness="0" 
                HeightRequest="70" 
                VerticalOptions="End">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="25,25,0,0" />
                </Border.StrokeShape>

                <!-- Nav Icons -->
                <Grid ColumnDefinitions="*, *, *" Padding="10,0">
                    <!-- Home-ikoon → navigates to the Home-page (nix-op here) -->
                    <Grid Grid.Column="0" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" VerticalOptions="Center">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateHomeCommand}" />
                        </Grid.GestureRecognizers>
                        <Path Data="M10,20 L10,14 L14,14 L14,20 L19,20 L19,12 L22,12 L12,3 L2,12 L5,12 L5,20 Z"
                              Fill="#5AA2F0"
                              Aspect="Uniform"
                              WidthRequest="24"
                              HeightRequest="24"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
                    </Grid>

                    <!-- Empty space for FAB: de orange button underneath handles te tickets-navigation -->
                    <BoxView Grid.Column="1" Color="Transparent" BackgroundColor="Transparent"/>

                    <Grid Grid.Column="2" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" VerticalOptions="Center">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateProfileCommand}" />
                        </Grid.GestureRecognizers>
                        <Path Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z"
                              Fill="White" Aspect="Uniform" WidthRequest="24" HeightRequest="24"
                              HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Floating Action Button (Orange) → navigates to the Ticket-page -->
            <Border BackgroundColor="#E86A22"
                StrokeThickness="0"
                WidthRequest="65"
                HeightRequest="65"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Margin="0,-35,0,0"
                ZIndex="1">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateTicketsCommand}" />
                </Border.GestureRecognizers>

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="32.5" />
                </Border.StrokeShape>

                <Path Data="M22,10 L22,6 C22,4.9 21.1,4 20,4 L4,4 C2.9,4 2.01,4.9 2.01,6 L2,10 C3.1,10 4,10.9 4,12 C4,13.1 3.1,14 2,14 L2,18 C2,19.1 2.9,20 4,20 L20,20 C21.1,20 22,19.1 22,18 L22,14 C20.9,14 20,13.1 20,12 C20,10.9 20.9,10 22,10 Z"
                  Fill="White"
                  Aspect="Uniform"
                  WidthRequest="28"
                  HeightRequest="28"
                  HorizontalOptions="Center"
                  VerticalOptions="Center" />
            </Border>
        </Grid>

    </Grid>
</ContentPage>