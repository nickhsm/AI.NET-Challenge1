<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PassengerTicketService.ViewModels"
             xmlns:models="clr-namespace:PassengerTicketService.Models"
             xmlns:components="clr-namespace:PassengerTicketService.Components"
             x:Class="PassengerTicketService.Views.HomePage"
             x:Name="RootPage"
             x:DataType="viewModels:IHomeViewModel"
             xmlns:zoft="clr-namespace:zoft.MauiExtensions.Controls;assembly=Zoft.MauiExtensions.Controls.AutoCompleteEntry"
             BackgroundColor="#101010"
             Shell.NavBarIsVisible="False"
             Title="HomePage">

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <!-- 1. Top Section -->
        <VerticalStackLayout Grid.Row="0" Padding="20,40,20,15" Spacing="15">
            <Label Text="Wat zoek je?" TextColor="White" FontSize="26" FontAttributes="Bold" />
        </VerticalStackLayout>

        <!-- 2. Search Card -->
        <Border Grid.Row="1" Margin="20,0,20,0" BackgroundColor="#2B2B2B" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto, Auto, Auto">

                <!-- Van / Naar Section -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="15,20,15,15">

                    <VerticalStackLayout Grid.Column="0" Spacing="15">

                        <!-- VAN -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Van:" TextColor="#A0A0A0" FontSize="14" />

                            <zoft:AutoCompleteEntry 
                                Placeholder="station, halte of adres"
                                Text="{Binding StartStationText}"
                                ItemsSource="{Binding StartSuggestions}"
                                SelectedSuggestion="{Binding SelectedStartStation}"
                                IsSuggestionListOpen="{Binding IsStartSuggestionsVisible, Mode=TwoWay}"
                                TextMemberPath="Name"
                                DisplayMemberPath="Name"
                                TextColor="White"
                                PlaceholderColor="#888888"
                                BackgroundColor="#3A3A3A"
                                HeightRequest="45"
                                HorizontalOptions="Fill" />
                        </VerticalStackLayout>

                        <!-- NAAR -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Naar:" TextColor="#A0A0A0" FontSize="14" />

                            <zoft:AutoCompleteEntry 
                                Placeholder="station, halte of adres"
                                Text="{Binding EndStationText}"
                                ItemsSource="{Binding EndSuggestions}"
                                SelectedSuggestion="{Binding SelectedEndStation}"
                                IsSuggestionListOpen="{Binding IsEndSuggestionsVisible, Mode=TwoWay}"
                                TextMemberPath="Name"
                                DisplayMemberPath="Name"
                                TextColor="White"
                                PlaceholderColor="#888888"
                                BackgroundColor="#3A3A3A"
                                HeightRequest="45"
                                HorizontalOptions="Fill" />
                        </VerticalStackLayout>

                        <Label Text="{Binding SearchErrorMessage}" TextColor="#FF6B6B" FontSize="14" />

                    </VerticalStackLayout>

                    <!-- Swap Button -->
                    <Border Grid.Column="1" 
                        BackgroundColor="#5AA2F0" 
                        WidthRequest="50" 
                        HeightRequest="50" 
                        VerticalOptions="Center"
                        HorizontalOptions="End">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="25" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SwapStationsCommand}" />
                        </Border.GestureRecognizers>
                        <Path Data="M9,3L5,7H8V14H10V7H13M16,17V10H14V17H11L15,21L19,17H16Z"
                          Fill="Black" Aspect="Uniform" WidthRequest="24" HeightRequest="24" 
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Datum Section -->
                <Grid Grid.Row="1" Padding="15,0,15,15">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Vertrek:" TextColor="#A0A0A0" FontSize="14" />
                        <HorizontalStackLayout Spacing="8">
                            <Path Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z" Fill="#5AA2F0" Aspect="Uniform" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Label Text="{Binding DateDisplayText}" TextColor="White" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <DatePicker Date="{Binding SelectedDate}" MinimumDate="{Binding MinimumDate}" Opacity="0" HorizontalOptions="Fill" VerticalOptions="Fill" />
                </Grid>

                <!-- Kopen Button -->
                <Button Grid.Row="2" Text="Kopen" Command="{Binding BuyTicketCommand}" BackgroundColor="#E86A22" TextColor="White" FontAttributes="Bold" FontSize="18" CornerRadius="0" HeightRequest="55" />
            </Grid>
        </Border>

        <!-- Navbar -->
        <components:BottomNavBar Grid.Row="3" SelectedTab="Home" />
    </Grid>
</ContentPage>