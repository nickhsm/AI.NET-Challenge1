<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PassengerTicketService.Views.HomePage"
             BackgroundColor="#101010"
             Shell.NavBarIsVisible="False"
             Title="HomePage">

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <!-- 1. Top Section: Header and Tabs -->
        <VerticalStackLayout Grid.Row="0" Padding="20,40,20,15" Spacing="15">
            <Label Text="Wat zoek je?" 
                TextColor="White" 
                FontSize="26" 
                FontAttributes="Bold" />
        </VerticalStackLayout>

        <!-- 2. Middle Section: Search Card -->
        <Border Grid.Row="1" 
            Margin="20,0,20,0" 
            BackgroundColor="#2B2B2B" 
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto, Auto, Auto">

                <!-- Van / Naar Section -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="15,20,15,15">

                    <!-- Input Fields -->
                    <VerticalStackLayout Grid.Column="0" Spacing="10">
                        <Label Text="Van:" TextColor="#A0A0A0" FontSize="14" />

                        <Grid VerticalOptions="Center">
                            <Entry Placeholder="station, halte of adres" HorizontalOptions="Fill"/>
                        </Grid>

                        <Label Text="Naar:" TextColor="#A0A0A0" FontSize="14" Margin="0,5,0,0" />

                        <Grid VerticalOptions="Center">
                            <Entry Placeholder="station, halte of adres" HorizontalOptions="Fill"/>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Swap Button -->
                    <Border Grid.Column="1" 
                        BackgroundColor="#5AA2F0" 
                        WidthRequest="50" 
                        HeightRequest="50" 
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="25" />
                        </Border.StrokeShape>
                        <Label Text="↑↓" 
                            TextColor="Black" 
                            FontSize="24" 
                            HorizontalOptions="Center" 
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Departure & Filters Section -->
                <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Padding="15,0,15,15">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Vertrek:" TextColor="#A0A0A0" FontSize="14" />
                        <HorizontalStackLayout Spacing="8">
                            <!-- Calendar Icon placeholder -->
                            <Label Text="📅" TextColor="#5AA2F0" FontSize="16" VerticalOptions="Center" />
                            <Label Text="vandaag" TextColor="White" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Filters Button -->
                    <Border Grid.Column="1" BackgroundColor="#5AA2F0" Padding="12,8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="⚙" TextColor="Black" FontSize="16" VerticalOptions="Center" />
                            <Label Text="Selecteer Datum" TextColor="Black" FontAttributes="Bold" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- Zoeken Button -->
                <Button Grid.Row="2" 
                    Text="Kopen" 
                    BackgroundColor="#E86A22" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    FontSize="18" 
                    CornerRadius="0" 
                    HeightRequest="55" />
            </Grid>
        </Border>

        <!-- 4. Bottom Navigation Bar -->
        <!-- We use a Grid to allow the pink FAB to overlap the top edge of the nav bar -->
        <Grid Grid.Row="3" VerticalOptions="End" Margin="0,20,0,0">

            <!-- Background Bar -->
            <Border BackgroundColor="#1C1C1E" 
                StrokeThickness="0" 
                HeightRequest="70" 
                VerticalOptions="End">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="25,25,0,0" />
                </Border.StrokeShape>

                <!-- Nav Icons -->
                <Grid ColumnDefinitions="*, *, *" Padding="10,0">
                    <!-- Home (Selected) -->
                    <Path Grid.Column="0"
                          Data="M10,20 L10,14 L14,14 L14,20 L19,20 L19,12 L22,12 L12,3 L2,12 L5,12 L5,20 Z"
                          Fill="White"
                          Aspect="Uniform"
                          WidthRequest="24"
                          HeightRequest="24"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />

                    <!-- Empty space for FAB -->
                    <BoxView Grid.Column="1" Color="Transparent" BackgroundColor="Transparent"/>

                    <!-- Profile (was Grid.Column="4" → 2) -->
                    <Path Grid.Column="2"
                          Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z"
                          Fill="White"
                          Aspect="Uniform"
                          WidthRequest="24"
                          HeightRequest="24"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Floating Action Button (Orange) -->
            <Border BackgroundColor="#E86A22"
                StrokeThickness="0"
                WidthRequest="65"
                HeightRequest="65"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Margin="0,-35,0,0"
                ZIndex="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="32.5" />
                </Border.StrokeShape>

                <Path Data="M22,10 L22,6 C22,4.9 21.1,4 20,4 L4,4 C2.9,4 2.01,4.9 2.01,6 L2,10 C3.1,10 4,10.9 4,12 C4,13.1 3.1,14 2,14 L2,18 C2,19.1 2.9,20 4,20 L20,20 C21.1,20 22,19.1 22,18 L22,14 C20.9,14 20,13.1 20,12 C20,10.9 20.9,10 22,10 Z"
                  Fill="White"
                  Aspect="Uniform"
                  WidthRequest="28"
                  HeightRequest="28"
                  HorizontalOptions="Center"
                  VerticalOptions="Center" />
            </Border>
        </Grid>

    </Grid>
</ContentPage>