<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PassengerTicketService.ViewModels"
             x:Class="PassengerTicketService.Views.RegisterPage"
             x:DataType="viewModels:IRegisterViewModel"
             BackgroundColor="#101010"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">

        <!-- 1. HEADER -->
        <Grid Grid.Row="0" Padding="20,40,20,15" ColumnDefinitions="Auto, *" ColumnSpacing="15">
            <Grid Grid.Column="0" WidthRequest="40" HeightRequest="40" HorizontalOptions="Start" VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateBackCommand}" />
                </Grid.GestureRecognizers>
                <Label Text="←" TextColor="White" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>

            <Label Grid.Column="1" Text="Account aanmaken" TextColor="White" FontSize="22" FontAttributes="Bold" VerticalOptions="Center" />
        </Grid>

        <!-- 2. FORMULIER -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,10,20,30" Spacing="15">

                <!-- Voornaam -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Voornaam:" TextColor="#5AA2F0" FontSize="14" Margin="5,0,0,0"/>
                    <Border Stroke="#444444" StrokeThickness="1" BackgroundColor="#1E1E1E" HeightRequest="50">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Entry Text="{Binding FirstName}" TextColor="White" BackgroundColor="Transparent" Margin="10,0" />
                    </Border>
                </VerticalStackLayout>

                <!-- Familienaam -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Familienaam:" TextColor="#5AA2F0" FontSize="14" Margin="5,0,0,0"/>
                    <Border Stroke="#444444" StrokeThickness="1" BackgroundColor="#1E1E1E" HeightRequest="50">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Entry Text="{Binding LastName}" TextColor="White" BackgroundColor="Transparent" Margin="10,0" />
                    </Border>
                </VerticalStackLayout>

                <!-- E-mail -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="E-mail:" TextColor="#5AA2F0" FontSize="14" Margin="5,0,0,0"/>
                    <Border Stroke="#444444" StrokeThickness="1" BackgroundColor="#1E1E1E" HeightRequest="50">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Entry Text="{Binding Email}" TextColor="White" BackgroundColor="Transparent" Margin="10,0" />
                    </Border>
                </VerticalStackLayout>

                <!-- Wachtwoord -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Wachtwoord:" TextColor="#5AA2F0" FontSize="14" Margin="5,0,0,0"/>
                    <Border Stroke="#444444" StrokeThickness="1" BackgroundColor="#1E1E1E" HeightRequest="50">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*, Auto" Margin="10,0">
                            <!-- Bind IsPassword direct aan IsPasswordHidden -->
                            <Entry Grid.Column="0" Text="{Binding Password}" TextColor="White" BackgroundColor="Transparent" IsPassword="{Binding IsPasswordHidden}" />

                            <Grid Grid.Column="1" WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TogglePasswordVisibilityCommand}" />
                                </Grid.GestureRecognizers>

                                <!-- Open Oog (zichtbaar als wachtwoord verborgen is) -->
                                <Path Data="M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5M12,17C9.24,17 7,14.76 7,12C7,9.24 9.24,7 12,7C14.76,7 17,9.24 17,12C17,14.76 14.76,17 12,17M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"
                                  Fill="#A0A0A0" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"
                                  IsVisible="{Binding IsPasswordHidden}" />

                                <!-- Gesloten Oog (zichtbaar als wachtwoord getoond wordt) -->
                                <Path Data="M11.83,9L15,12.16C15,12.11 15,12.05 15,12A3,3 0 0,0 12,9C11.94,9 11.89,9 11.83,9M7.53,9.8L9.08,11.35C9.03,11.56 9,11.77 9,12A3,3 0 0,0 12,15C12.22,15 12.44,14.97 12.65,14.92L14.2,16.47C13.53,16.8 12.79,17 12,17A5,5 0 0,1 7,12C7,11.21 7.2,10.47 7.53,9.8M2,4.27L4.28,6.55L4.73,7C3.08,8.3 1.78,10 1,12C2.73,16.39 7,19.5 12,19.5C13.55,19.5 15.03,19.2 16.38,18.66L16.81,19.08L19.73,22L21,20.73L3.27,3M12,7A5,5 0 0,1 17,12C17,12.64 16.87,13.26 16.64,13.82L19.57,16.75C21.07,15.5 22.27,13.86 23,12C21.27,7.61 17,4.5 12,4.5C10.6,4.5 9.26,4.75 8,5.2L10.17,7.35C10.74,7.13 11.35,7 12,7Z"
                                  Fill="#A0A0A0" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"
                                  IsVisible="{Binding IsPasswordVisible}" />
                            </Grid>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Wachtwoord bevestigen -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Wachtwoord bevestigen:" TextColor="#5AA2F0" FontSize="14" Margin="5,0,0,0"/>
                    <Border Stroke="#444444" StrokeThickness="1" BackgroundColor="#1E1E1E" HeightRequest="50">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*, Auto" Margin="10,0">
                            <!-- Bind IsPassword direct aan IsConfirmPasswordHidden -->
                            <Entry Grid.Column="0" Text="{Binding ConfirmPassword}" TextColor="White" BackgroundColor="Transparent" IsPassword="{Binding IsConfirmPasswordHidden}" />

                            <Grid Grid.Column="1" WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleConfirmPasswordVisibilityCommand}" />
                                </Grid.GestureRecognizers>

                                <Path Data="M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5M12,17C9.24,17 7,14.76 7,12C7,9.24 9.24,7 12,7C14.76,7 17,9.24 17,12C17,14.76 14.76,17 12,17M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"
                      Fill="#A0A0A0" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"
                      IsVisible="{Binding IsConfirmPasswordHidden}" />

                                <Path Data="M11.83,9L15,12.16C15,12.11 15,12.05 15,12A3,3 0 0,0 12,9C11.94,9 11.89,9 11.83,9M7.53,9.8L9.08,11.35C9.03,11.56 9,11.77 9,12A3,3 0 0,0 12,15C12.22,15 12.44,14.97 12.65,14.92L14.2,16.47C13.53,16.8 12.79,17 12,17A5,5 0 0,1 7,12C7,11.21 7.2,10.47 7.53,9.8M2,4.27L4.28,6.55L4.73,7C3.08,8.3 1.78,10 1,12C2.73,16.39 7,19.5 12,19.5C13.55,19.5 15.03,19.2 16.38,18.66L16.81,19.08L19.73,22L21,20.73L3.27,3M12,7A5,5 0 0,1 17,12C17,12.64 16.87,13.26 16.64,13.82L19.57,16.75C21.07,15.5 22.27,13.86 23,12C21.27,7.61 17,4.5 12,4.5C10.6,4.5 9.26,4.75 8,5.2L10.17,7.35C10.74,7.13 11.35,7 12,7Z"
                      Fill="#A0A0A0" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"
                      IsVisible="{Binding IsConfirmPasswordVisible}" />
                            </Grid>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Geboortedatum -->
                <VerticalStackLayout Spacing="5" Margin="0,10,0,0">
                    <Label Text="Geboortedatum:" TextColor="#5AA2F0" FontSize="14" Margin="5,0,0,0"/>
                    <DatePicker Date="{Binding BirthDate}" Format="dd/MM/yyyy" TextColor="White" BackgroundColor="Transparent" HorizontalOptions="Fill" Margin="10,0" />
                </VerticalStackLayout>

                <!-- Aanmaken Knop (Oranje) -->
                <Button Text="Account aanmaken" 
                        Command="{Binding RegisterCommand}"
                        BackgroundColor="#E86A22" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        FontSize="16"
                        CornerRadius="8" 
                        HeightRequest="55" 
                        Margin="0,20,0,0" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>