<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PassengerTicketService.Views.YourTravelPage"
             BackgroundColor="#101010"
             Shell.NavBarIsVisible="False">

    <!-- 3 Rijen: Header, Scrollbare inhoud, Vaste bodemknop -->
    <Grid RowDefinitions="Auto, *, Auto">

        <!-- 1. HEADER (Vast bovenaan) -->
        <HorizontalStackLayout Grid.Row="0" Padding="20,20,20,15" Spacing="15">
            <!-- Back arrow (vervang met echte icoon indien nodig) -->
            <Label Text="←" TextColor="White" FontSize="24" VerticalOptions="Center" />
            <Label Text="Jouw reis" TextColor="White" FontSize="22" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- 2. SCROLLBARE INHOUD -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0,20,30" Spacing="25">

                <!-- Reis Kaart (Van/Naar) -->
                <Border BackgroundColor="#2B2B2B" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid RowDefinitions="Auto, Auto">

                        <!-- Bovenste deel: Van & Naar -->
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="15,20,15,15">
                            <VerticalStackLayout Grid.Column="0" Spacing="10">
                                <Label Text="Van:" TextColor="#A0A0A0" FontSize="14" />

                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                                    <Ellipse Fill="Transparent" Stroke="#5AA2F0" StrokeThickness="3" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="MOL" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>

                                <!-- Stippellijn placeholder (BoxView zonder CornerRadius) -->
                                <BoxView Color="#5AA2F0" HeightRequest="20" WidthRequest="3" HorizontalOptions="Start" Margin="7,0,0,0" />

                                <Label Text="Naar:" TextColor="#A0A0A0" FontSize="14" Margin="0,5,0,0" />

                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                                    <Ellipse Fill="Transparent" Stroke="#5AA2F0" StrokeThickness="2" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="GEEL" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>

                            <!-- Swap Knop -->
                            <Border Grid.Column="1" BackgroundColor="#5AA2F0" WidthRequest="50" HeightRequest="50" VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="25" />
                                </Border.StrokeShape>
                                <Label Text="↑↓" TextColor="Black" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <!-- Onderste deel: Vertrek datum (Fout opgelost: StrokeShape verwijderd) -->
                        <Grid Grid.Row="1" ColumnDefinitions="Auto, *" Padding="15,15" BackgroundColor="#222222">
                            <HorizontalStackLayout Spacing="10">
                                <!-- Kalender icoon placeholder -->
                                <Label Text="📅" TextColor="#5AA2F0" FontSize="18" VerticalOptions="Center" />
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Vertrek:" TextColor="#A0A0A0" FontSize="14" />
                                    <Label Text="vandaag" TextColor="White" FontSize="16" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Reistype Sectie -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Reistype" TextColor="White" FontSize="18" FontAttributes="Bold" />
                    <Border BackgroundColor="#2B2B2B" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*, *" HeightRequest="45">
                            <!-- Actieve knop (Enkel) -->
                            <Border Grid.Column="0" BackgroundColor="#5AA2F0" Margin="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8,0,0,8" />
                                </Border.StrokeShape>
                                <Label Text="Enkel" TextColor="Black" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <!-- Inactieve knop (Heen en terug) -->
                            <Label Grid.Column="1" Text="Heen en terug" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Reizigers Sectie -->
                <VerticalStackLayout Spacing="15">
                    <Label Text="Reiziger(s) x1" TextColor="White" FontSize="18" FontAttributes="Bold" />

                    <!-- Reiziger Kaart -->
                    <Border Stroke="White" StrokeThickness="1" BackgroundColor="Transparent" Padding="15">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto">

                            <!-- Naam -->
                            <Label Grid.Row="1" Grid.Column="0" Text="JONATHAN YANG" TextColor="White" FontSize="18" FontAttributes="Bold" />

                            <!-- Leeftijd -->
                            <Label Grid.Row="2" Grid.Column="0" Text="(12 - 25)" TextColor="#A0A0A0" FontSize="14" />

                            <!-- Actie Knoppen (Edit & Delete) -->
                            <HorizontalStackLayout Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Spacing="10" VerticalOptions="Center">
                                <!-- Edit -->
                                <Border BackgroundColor="#5AA2F0" WidthRequest="40" HeightRequest="40">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <Label Text="✎" TextColor="Black" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <!-- Delete -->
                                <Border BackgroundColor="#D32F2F" WidthRequest="40" HeightRequest="40">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <Label Text="🗑" TextColor="White" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Voeg Reiziger Toe Knop -->
                    <Button Text="+ Voeg reiziger toe" 
                            BackgroundColor="#5AA2F0" 
                            TextColor="Black" 
                            FontAttributes="Bold" 
                            CornerRadius="8" 
                            HeightRequest="45" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 3. VASTE BOTTOM BAR (Bevestigen) -->
        <Grid Grid.Row="2" BackgroundColor="#161616" Padding="20,15,20,25">
            <Button Text="Bevestigen" 
                    BackgroundColor="#E86A22" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    FontSize="18"
                    CornerRadius="8" 
                    HeightRequest="55" />
        </Grid>

    </Grid>
</ContentPage>