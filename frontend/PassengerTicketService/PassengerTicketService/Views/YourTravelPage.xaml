<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PassengerTicketService.ViewModels"
             xmlns:converters="clr-namespace:PassengerTicketService.Converters" 
             x:Class="PassengerTicketService.Views.YourTravelPage"
             x:DataType="viewModels:IYourTravelViewModel"
             BackgroundColor="#101010"
             Shell.NavBarIsVisible="False">

    <!-- Converter registreren -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:DateToStringConverter x:Key="DateToStringConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Grid met 3 rijen: Header, Scrollbare inhoud, Vaste bodemknop -->
    <Grid RowDefinitions="Auto, *, Auto" Padding="20,40,20,20">

        <!-- 1. Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,0,0,20">

            <!-- Klikbare pijl (Groter klikvlak door de Grid) -->
            <Grid Grid.Column="0" WidthRequest="40" HeightRequest="40" HorizontalOptions="Start" VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateBackCommand}" />
                </Grid.GestureRecognizers>
                <Label Text="←" TextColor="White" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>

            <!-- Titel (Zelfde stijl als HomePage) -->
            <Label Grid.Column="1" Text="Jouw reis" TextColor="White" FontSize="22" FontAttributes="Bold" VerticalOptions="Center" />
        </Grid>

        <!-- 2. Scrollbare inhoud -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="20" Padding="0,0,0,20">

                <!-- Reis Kaart (Van/Naar) - HomePage Stijl -->
                <Border BackgroundColor="#2B2B2B" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Grid RowDefinitions="Auto, Auto">

                        <!-- Van / Naar Section -->
                        <VerticalStackLayout Grid.Row="0" Padding="15,20,15,15" Spacing="10">

                            <Label Text="Van:" TextColor="#A0A0A0" FontSize="14" />

                            <Label Text="{Binding CurrentRequest.StartStation}" 
                               TextColor="White" 
                               FontSize="18" 
                               FontAttributes="Bold"
                               VerticalOptions="Center" />

                            <Label Text="Naar:" TextColor="#A0A0A0" FontSize="14" Margin="0,5,0,0" />

                            <Label Text="{Binding CurrentRequest.EndStation}" 
                               TextColor="White" 
                               FontSize="18" 
                               FontAttributes="Bold"
                               VerticalOptions="Center" />

                        </VerticalStackLayout>

                        <!-- Departure Section (Zonder de filters knop) -->
                        <Border Grid.Row="1" Padding="15,15" BackgroundColor="#222222" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="0,0,12,12" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="*, Auto, *">
                                <!-- Vertrek Datum -->
                                <Grid Grid.Column="0">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Vertrek:" TextColor="#A0A0A0" FontSize="12" />
                                        <HorizontalStackLayout Spacing="8">
                                            <Path Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z" Fill="#5AA2F0" Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                            <!-- Converter toegepast -->
                                            <Label Text="{Binding CurrentRequest.ExpirationDate, Converter={StaticResource DateToStringConverter}}" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <DatePicker Date="{Binding CurrentRequest.ExpirationDate}" MinimumDate="{Binding MinimumDate}" Opacity="0" HorizontalOptions="Fill" VerticalOptions="Fill" />
                                </Grid>

                                <!-- Scheidingslijn -->
                                <BoxView Grid.Column="1" WidthRequest="1" Color="#444444" Margin="10,0" IsVisible="{Binding CurrentRequest.IsRoundTrip}" />

                                <!-- Terugreis Datum -->
                                <Grid Grid.Column="2" IsVisible="{Binding CurrentRequest.IsRoundTrip}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Terugreis:" TextColor="#A0A0A0" FontSize="12" />
                                        <HorizontalStackLayout Spacing="8">
                                            <Path Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z" Fill="#5AA2F0" Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                            <!-- Converter toegepast -->
                                            <Label Text="{Binding CurrentRequest.ReturnExpirationDate, Converter={StaticResource DateToStringConverter}}" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <DatePicker Date="{Binding CurrentRequest.ReturnExpirationDate}" MinimumDate="{Binding CurrentRequest.ExpirationDate}" Opacity="0" HorizontalOptions="Fill" VerticalOptions="Fill" />

                                    <!-- Vuilnisbak icoon (gebruikt SelectSingleTripCommand om retour te verwijderen) -->
                                    <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" 
                                          Fill="#E74C3C" Aspect="Uniform" WidthRequest="20" HeightRequest="20" 
                                          HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,5,0">
                                        <Path.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectSingleTripCommand}" />
                                        </Path.GestureRecognizers>
                                    </Path>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Reistype Sectie (Segmented Control) -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Reistype" TextColor="White" FontSize="16" FontAttributes="Bold" />
                    <Border BackgroundColor="#2B2B2B" StrokeThickness="0" Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*, *" HeightRequest="50">

                            <!-- Enkel (Linkerkant) -->
                            <Border Grid.Column="0" BackgroundColor="#2B2B2B" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8,0,0,8" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding CurrentRequest.IsRoundTrip}" Value="False">
                                        <Setter Property="BackgroundColor" Value="#5AA2F0" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="Enkel" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding CurrentRequest.IsRoundTrip}" Value="False">
                                            <Setter Property="TextColor" Value="Black" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Border.GestureRecognizers>
                                    <!-- FIX: Bind aan het commando -->
                                    <TapGestureRecognizer Command="{Binding SelectSingleTripCommand}" />
                                </Border.GestureRecognizers>
                            </Border>

                            <!-- Heen en terug (Rechterkant) -->
                            <Border Grid.Column="1" BackgroundColor="#2B2B2B" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="0,8,8,0" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding CurrentRequest.IsRoundTrip}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#5AA2F0" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="Heen en terug" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding CurrentRequest.IsRoundTrip}" Value="True">
                                            <Setter Property="TextColor" Value="Black" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Border.GestureRecognizers>
                                    <!-- FIX: Bind aan het commando -->
                                    <TapGestureRecognizer Command="{Binding SelectRoundTripCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Reizigers Sectie -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding CurrentRequest.PassengerCount, StringFormat='Reiziger(s) x{0}'}" TextColor="White" FontSize="16" FontAttributes="Bold" />

                    <!-- Simpele passagier teller (Stepper) -->
                    <Border BackgroundColor="#2B2B2B" StrokeThickness="0" Padding="15,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Aantal personen" TextColor="#A0A0A0" VerticalOptions="Center"/>
                            <HorizontalStackLayout Grid.Column="1" Spacing="15">
                                <Stepper Minimum="1" Maximum="10" Increment="1" Value="{Binding CurrentRequest.PassengerCount}" />
                                <Label Text="{Binding CurrentRequest.PassengerCount}" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" WidthRequest="25" HorizontalTextAlignment="Center"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 3. Bevestigen Knop (Vast onderaan) -->
        <Grid Grid.Row="2" Padding="0,10,0,0">
            <Button Text="Bevestigen" 
                    Command="{Binding ConfirmTravelCommand}" 
                    BackgroundColor="#E86A22" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    FontSize="16"
                    CornerRadius="8" 
                    HeightRequest="55" />
        </Grid>
    </Grid>
</ContentPage>