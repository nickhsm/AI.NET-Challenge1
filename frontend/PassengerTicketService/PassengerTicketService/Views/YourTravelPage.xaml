<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PassengerTicketService.ViewModels"
             x:Class="PassengerTicketService.Views.YourTravelPage"
             x:DataType="viewModels:IYourTravelViewModel"
             BackgroundColor="#101010"
             Shell.NavBarIsVisible="False">

    <!-- Grid met 3 rijen: Header, Scrollbare inhoud, Vaste bodemknop -->
    <Grid RowDefinitions="Auto, *, Auto" Padding="20,40,20,20">

        <!-- 1. Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,0,0,20">

            <!-- Klikbare pijl (Groter klikvlak door de Grid) -->
            <Grid Grid.Column="0" WidthRequest="40" HeightRequest="40" HorizontalOptions="Start" VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateBackCommand}" />
                </Grid.GestureRecognizers>
                <Label Text="←" TextColor="White" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>

            <!-- Titel (Zelfde stijl als HomePage) -->
            <Label Grid.Column="1" Text="Jouw reis" TextColor="White" FontSize="22" FontAttributes="Bold" VerticalOptions="Center" />
        </Grid>

        <!-- 2. Scrollbare inhoud -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="20" Padding="0,0,0,20">

                <!-- Reis Kaart (Van/Naar) - HomePage Stijl -->
                <Border BackgroundColor="#2B2B2B" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Grid RowDefinitions="Auto, Auto">

                        <!-- Van / Naar Section -->
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="15,20,15,15">

                            <!-- Input Fields -->
                            <VerticalStackLayout Grid.Column="0" Spacing="10">
                                <Label Text="Van:" TextColor="#A0A0A0" FontSize="14" />

                                <Label Text="{Binding CurrentRequest.StartStation}" 
                                       TextColor="White" 
                                       FontSize="18" 
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />

                                <Label Text="Naar:" TextColor="#A0A0A0" FontSize="14" Margin="0,5,0,0" />

                                <Label Text="{Binding CurrentRequest.EndStation}" 
                                       TextColor="White" 
                                       FontSize="18" 
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                            </VerticalStackLayout>

                            <!-- Swap Button -->
                            <Border Grid.Column="1" 
                                    BackgroundColor="#5AA2F0" 
                                    WidthRequest="50" 
                                    HeightRequest="50" 
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="25" />
                                </Border.StrokeShape>
                                <Label Text="↑↓" 
                                       TextColor="Black" 
                                       FontSize="24" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <!-- Departure Section (Zonder de filters knop) -->
                        <Grid Grid.Row="1" ColumnDefinitions="*" Padding="15,0,15,15">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Vertrek:" TextColor="#A0A0A0" FontSize="14" />
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="📅" TextColor="#5AA2F0" FontSize="16" VerticalOptions="Center" />
                                    <Label Text="vandaag" TextColor="White" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                    </Grid>
                </Border>

                <!-- Reistype Sectie (Segmented Control) -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Reistype" TextColor="White" FontSize="16" FontAttributes="Bold" />
                    <Border BackgroundColor="#2B2B2B" StrokeThickness="0" Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*, *" HeightRequest="50">

                            <!-- Enkel (Linkerkant) -->
                            <Border Grid.Column="0" BackgroundColor="#2B2B2B" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8,0,0,8" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding CurrentRequest.IsRoundTrip}" Value="False">
                                        <Setter Property="BackgroundColor" Value="#5AA2F0" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="Enkel" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding CurrentRequest.IsRoundTrip}" Value="False">
                                            <Setter Property="TextColor" Value="Black" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Border.GestureRecognizers>
                                    <!-- FIX: Bind aan het commando -->
                                    <TapGestureRecognizer Command="{Binding SelectSingleTripCommand}" />
                                </Border.GestureRecognizers>
                            </Border>

                            <!-- Heen en terug (Rechterkant) -->
                            <Border Grid.Column="1" BackgroundColor="#2B2B2B" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="0,8,8,0" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding CurrentRequest.IsRoundTrip}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#5AA2F0" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="Heen en terug" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding CurrentRequest.IsRoundTrip}" Value="True">
                                            <Setter Property="TextColor" Value="Black" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Border.GestureRecognizers>
                                    <!-- FIX: Bind aan het commando -->
                                    <TapGestureRecognizer Command="{Binding SelectRoundTripCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Reizigers Sectie -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding CurrentRequest.PassengerCount, StringFormat='Reiziger(s) x{0}'}" TextColor="White" FontSize="16" FontAttributes="Bold" />

                    <!-- Simpele passagier teller (Stepper) -->
                    <Border BackgroundColor="#2B2B2B" StrokeThickness="0" Padding="15,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Aantal personen" TextColor="#A0A0A0" VerticalOptions="Center"/>
                            <HorizontalStackLayout Grid.Column="1" Spacing="15">
                                <Stepper Minimum="1" Maximum="10" Increment="1" Value="{Binding CurrentRequest.PassengerCount}" />
                                <Label Text="{Binding CurrentRequest.PassengerCount}" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" WidthRequest="25" HorizontalTextAlignment="Center"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 3. Bevestigen Knop (Vast onderaan) -->
        <Grid Grid.Row="2" Padding="0,10,0,0">
            <Button Text="Bevestigen" 
                    Command="{Binding ConfirmTravelCommand}" 
                    BackgroundColor="#E86A22" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    FontSize="16"
                    CornerRadius="8" 
                    HeightRequest="55" />
        </Grid>
    </Grid>
</ContentPage>