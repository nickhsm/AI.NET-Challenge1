<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PassengerTicketService.ViewModels"
             x:Class="PassengerTicketService.Views.YourTravelPage"
             x:DataType="viewModels:IYourTravelViewModel"
             BackgroundColor="#101010"
             Shell.NavBarIsVisible="False">

    <!-- Grid met 3 rijen: Header, Scrollbare inhoud, Vaste bodemknop -->
    <Grid RowDefinitions="Auto, *, Auto" Padding="20,40,20,20">

        <!-- 1. Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,0,0,20">
            <Label Text="←" TextColor="White" FontSize="24" VerticalOptions="Center" Margin="0,0,15,0" />
            <Label Grid.Column="1" Text="Jouw reis" TextColor="White" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
        </Grid>

        <!-- 2. Scrollbare inhoud -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="20" Padding="0,0,0,20">

                <!-- Reis Kaart (Van/Naar) -->
                <Border BackgroundColor="#2B2B2B" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Grid RowDefinitions="Auto, Auto">
                        <!-- Bovenste deel: Van & Naar -->
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="15,20,15,15">

                            <!-- Route: iconen en tekst -->
                            <Grid Grid.Column="0" ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="15">

                                <!-- Van -->
                                <Ellipse Grid.Row="0" Grid.Column="0" Fill="Transparent" Stroke="#5AA2F0" StrokeThickness="3" WidthRequest="18" HeightRequest="18" VerticalOptions="Start" Margin="0,5,0,0"/>
                                <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                    <Label Text="Van:" TextColor="#A0A0A0" FontSize="12" />
                                    <Label Text="{Binding CurrentRequest.StartStation, TargetNullValue='...'}" TextColor="White" FontSize="16" FontAttributes="Bold" />
                                </VerticalStackLayout>

                                <!-- Lijn -->
                                <BoxView Grid.Row="1" Grid.Column="0" Color="#5AA2F0" WidthRequest="2" HeightRequest="25" HorizontalOptions="Center" Margin="0,2,0,2" />

                                <!-- Naar -->
                                <Ellipse Grid.Row="2" Grid.Column="0" Fill="Transparent" Stroke="#5AA2F0" StrokeThickness="2" WidthRequest="18" HeightRequest="18" VerticalOptions="Start" Margin="0,5,0,0"/>
                                <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="2">
                                    <Label Text="Naar:" TextColor="#A0A0A0" FontSize="12" />
                                    <Label Text="{Binding CurrentRequest.EndStation, TargetNullValue='...'}" TextColor="White" FontSize="16" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Swap Knop -->
                            <Border Grid.Column="1" BackgroundColor="#5AA2F0" WidthRequest="45" HeightRequest="45" VerticalOptions="Center" HorizontalOptions="End">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22.5" />
                                </Border.StrokeShape>
                                <Label Text="↑↓" TextColor="Black" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <!-- Onderste deel: Vertrek datum -->
                        <Border Grid.Row="1" Padding="15,15" BackgroundColor="#222222">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="0,0,12,12" />
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="15">
                                <!-- Kalender Icoon (Unicode placeholder) -->
                                <Label Text="📅" TextColor="#5AA2F0" FontSize="22" VerticalOptions="Center" />
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Vertrek:" TextColor="#A0A0A0" FontSize="12" />
                                    <Label Text="vandaag" TextColor="White" FontSize="16" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <!-- Reistype Sectie (Segmented Control) -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Reistype" TextColor="White" FontSize="16" FontAttributes="Bold" />
                    <Border BackgroundColor="#2B2B2B" StrokeThickness="0" Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*, *" HeightRequest="50">

                            <!-- Enkel (Linkerkant) -->
                            <Border Grid.Column="0" BackgroundColor="#2B2B2B" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8,0,0,8" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding CurrentRequest.IsRoundTrip}" Value="False">
                                        <Setter Property="BackgroundColor" Value="#5AA2F0" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="Enkel" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding CurrentRequest.IsRoundTrip}" Value="False">
                                            <Setter Property="TextColor" Value="Black" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEnkelTapped" />
                                </Border.GestureRecognizers>
                            </Border>

                            <!-- Heen en terug (Rechterkant) -->
                            <Border Grid.Column="1" BackgroundColor="#2B2B2B" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="0,8,8,0" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding CurrentRequest.IsRoundTrip}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#5AA2F0" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="Heen en terug" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding CurrentRequest.IsRoundTrip}" Value="True">
                                            <Setter Property="TextColor" Value="Black" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnHeenEnTerugTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Reizigers Sectie -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding CurrentRequest.PassengerCount, StringFormat='Reiziger(s) x{0}'}" TextColor="White" FontSize="16" FontAttributes="Bold" />

                    <!-- Simpele passagier teller (Stepper) -->
                    <Border BackgroundColor="#2B2B2B" StrokeThickness="0" Padding="15,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Aantal personen" TextColor="#A0A0A0" VerticalOptions="Center"/>
                            <HorizontalStackLayout Grid.Column="1" Spacing="15">
                                <Stepper Minimum="1" Maximum="10" Increment="1" Value="{Binding CurrentRequest.PassengerCount}" />
                                <Label Text="{Binding CurrentRequest.PassengerCount}" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" WidthRequest="25" HorizontalTextAlignment="Center"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 3. Bevestigen Knop (Vast onderaan) -->
        <Grid Grid.Row="2" Padding="0,10,0,0">
            <Button Text="Bevestigen" 
                    Command="{Binding ConfirmTravelCommand}" 
                    BackgroundColor="#E86A22" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    FontSize="16"
                    CornerRadius="8" 
                    HeightRequest="55" />
        </Grid>
    </Grid>
</ContentPage>