<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PassengerTicketService.Views.ShoppingCartPage"
             BackgroundColor="#0F0F0F"
             Shell.NavBarIsVisible="False"
             Title="ShoppingCartPage">
    <!-- Hoofd Grid: Header (Auto), Content (*), Bottom (Auto) -->
    <Grid RowDefinitions="Auto, *, Auto">

        <!-- 1. HEADER -->
        <Grid Grid.Row="0" BackgroundColor="#1B3248" Padding="20,40,20,15" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
            <!-- Back Arrow -->
            <Label Grid.Column="0" Text="←" TextColor="White" FontSize="26" VerticalOptions="Center" />

            <!-- Title -->
            <Label Grid.Column="1" Text="Jouw&#10;winkelwagen" TextColor="White" FontSize="20" FontAttributes="Bold" LineHeight="1.1" VerticalOptions="Center" />

            <!-- Clear Cart -->
            <Label Grid.Column="2" Text="Mandje leegmaken" TextColor="White" FontSize="14" FontAttributes="Bold" TextDecorations="Underline" VerticalOptions="Center" />
        </Grid>

        <!-- 2. MAIN CONTENT (Scrollable) -->
        <ScrollView Grid.Row="1" BackgroundColor="#1B3248">
            <VerticalStackLayout Padding="20,10,20,30" Spacing="20">

                <!-- Route (MOL -> GEEL) -->
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                    <!-- Graphics (Line and Circles) -->
                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="0">
                        <!-- Start Circle -->
                        <Ellipse Fill="White" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" />
                        <!-- Line -->
                        <BoxView Color="#3B5873" WidthRequest="2" HeightRequest="25" HorizontalOptions="Center" />
                        <!-- End Circle -->
                        <Ellipse Fill="Transparent" Stroke="White" StrokeThickness="2" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Text -->
                    <VerticalStackLayout Grid.Column="1" Spacing="19">
                        <Label Text="MOL" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Text="GEEL" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Trip Details -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Vertrek: Vandaag, 27/10/2026" TextColor="White" FontSize="15" FontAttributes="Bold" />
                    <Label Text="2e klas" TextColor="White" FontSize="15" FontAttributes="Bold" />
                </VerticalStackLayout>

                <!-- Separator -->
                <BoxView Color="#3B5873" HeightRequest="1" HorizontalOptions="Fill" />

                <!-- Heenreis Expandable Section -->
                <VerticalStackLayout Spacing="15">
                    <!-- Header -->
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="10">
                            <Label Text="^" TextColor="White" FontSize="18" VerticalOptions="Center" />
                            <Label Text="Heenreis" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Grid.Column="2" Text="€ 2,60" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>

                    <!-- Inner Separator -->
                    <BoxView Color="#3B5873" HeightRequest="1" HorizontalOptions="Fill" Margin="0,5,0,5" />

                    <!-- Tickets Info -->
                    <Label Text="Tickets" TextColor="White" FontSize="16" FontAttributes="Bold" Margin="0,0,0,5" />

                    <Grid ColumnDefinitions="*, Auto" Margin="10,0,0,0">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="Ticket Elk Moment Jongere x1" TextColor="White" FontSize="15" />
                            <Label Text="JONATHAN YANG" TextColor="White" FontSize="15" />
                            <Label Text="(12 - 25)" TextColor="#B0B0B0" FontSize="14" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="€ 2,60" TextColor="White" FontSize="16" FontAttributes="Bold" VerticalOptions="Start" />
                    </Grid>
                </VerticalStackLayout>

                <!-- Separator -->
                <BoxView Color="#3B5873" HeightRequest="1" HorizontalOptions="Fill" />

                <!-- Totaal -->
                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" Text="Totaal" TextColor="White" FontSize="18" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="€ 2,60" TextColor="White" FontSize="18" FontAttributes="Bold" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 3. BOTTOM ACTION AREA -->
        <VerticalStackLayout Grid.Row="2" BackgroundColor="#0F0F0F" Padding="20,30,20,30" Spacing="20">

            <!-- Betaal Knop (Inactief/Grijs zoals op de afbeelding) -->
            <Border BackgroundColor="#444444" HeightRequest="55">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label Text="Betalen (€ 2,60)" 
                       TextColor="#A0A0A0" 
                       FontAttributes="Bold" 
                       FontSize="18" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" />
            </Border>

            <!-- Annuleren Knop (Tekst only) -->
            <Label Text="Annuleren" 
                   TextColor="White" 
                   FontAttributes="Bold" 
                   FontSize="16" 
                   HorizontalOptions="Center" 
                   VerticalOptions="Center" 
                   Margin="0,10,0,0" />

        </VerticalStackLayout>

    </Grid>
</ContentPage>