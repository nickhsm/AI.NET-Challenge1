<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PassengerTicketService.ViewModels"
             x:Class="PassengerTicketService.Views.ShoppingCartPage"
             x:DataType="viewModels:IShoppingCartViewModel"
             Title="ShoppingCartPage"
             BackgroundColor="#0F0F0F"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- 1. HEADER (Zonder 'Mandje leegmaken') -->
        <Grid Grid.Row="0" BackgroundColor="#1B3248" Padding="20,40,20,15" ColumnDefinitions="Auto, *" ColumnSpacing="15">
            <Grid Grid.Column="0" WidthRequest="40" HeightRequest="40" HorizontalOptions="Start" VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateBackCommand}" />
                </Grid.GestureRecognizers>
                <Label Text="←" TextColor="White" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>

            <Label Grid.Column="1" Text="Jouw&#10;winkelwagen" TextColor="White" FontSize="20" FontAttributes="Bold" LineHeight="1.1" VerticalOptions="Center" />
        </Grid>

        <!-- 2. MAIN CONTENT -->
        <ScrollView Grid.Row="1" BackgroundColor="#1B3248">
            <VerticalStackLayout Padding="20,20,20,30" Spacing="20">

                <!-- Route (MOL -> GEEL) -->
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="0">
                        <Ellipse Fill="White" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" />
                        <BoxView Color="#3B5873" WidthRequest="2" HeightRequest="25" HorizontalOptions="Center" />
                        <Ellipse Fill="Transparent" Stroke="White" StrokeThickness="2" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="19">
                        <Label Text="{Binding CurrentRequest.StartStation, TargetNullValue='...'}" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Text="{Binding CurrentRequest.EndStation, TargetNullValue='...'}" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Reis Details (Datum & Aantal Passagiers) -->
                <VerticalStackLayout Spacing="5">
                    <!-- Vertrek datum (altijd zichtbaar) -->
                    <Label Text="{Binding ExpirationDateDisplay, StringFormat='Vertrek: {0}'}" TextColor="White" FontSize="15" FontAttributes="Bold" />

                    <!-- Retour datum (alleen zichtbaar als IsRoundTrip true is) -->
                    <Label Text="{Binding ExpirationDateDisplay, StringFormat='Retour: {0}'}" 
                           TextColor="White" FontSize="15" FontAttributes="Bold"
                           IsVisible="{Binding CurrentRequest.IsRoundTrip}" />

                    <!-- Vervangen 'Klas' door aantal passagiers -->
                    <Label Text="{Binding PassengerCountDisplay}" TextColor="White" FontSize="15" FontAttributes="Bold" Margin="0,5,0,0" />
                </VerticalStackLayout>

                <!-- Separator -->
                <BoxView Color="#3B5873" HeightRequest="1" HorizontalOptions="Fill" />

                <!-- Heenreis Sectie -->
                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" Text="Heenreis" TextColor="White" FontSize="18" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="{Binding OutboundPriceDisplay}" TextColor="White" FontSize="18" FontAttributes="Bold" />
                </Grid>

                <!-- Terugreis Sectie (Alleen zichtbaar bij een retourtje) -->
                <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding CurrentRequest.IsRoundTrip}">
                    <Label Grid.Column="0" Text="Terugreis" TextColor="White" FontSize="18" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="{Binding ReturnPriceDisplay}" TextColor="White" FontSize="18" FontAttributes="Bold" />
                </Grid>

                <!-- Separator -->
                <BoxView Color="#3B5873" HeightRequest="1" HorizontalOptions="Fill" />

                <!-- Totaal -->
                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" Text="Totaal" TextColor="White" FontSize="18" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="{Binding TotalPriceDisplay}" TextColor="White" FontSize="18" FontAttributes="Bold" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 3. BOTTOM ACTION AREA (Zonder comfort en voorwaarden) -->
        <VerticalStackLayout Grid.Row="2" BackgroundColor="#0F0F0F" Padding="20,20,20,30" Spacing="15">

            <Button Text="{Binding TotalPriceDisplay, StringFormat='Betalen'}" 
                    Command="{Binding PayCommand}"
                    BackgroundColor="#E86A22" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    FontSize="18"
                    CornerRadius="8" 
                    HeightRequest="55" />

            <Button Text="Annuleren" 
                    Command="{Binding CancelCommand}"
                    BackgroundColor="Transparent"
                    TextColor="White" 
                    FontAttributes="Bold" 
                    FontSize="16" 
                    HeightRequest="44" />

        </VerticalStackLayout>

    </Grid>
</ContentPage>