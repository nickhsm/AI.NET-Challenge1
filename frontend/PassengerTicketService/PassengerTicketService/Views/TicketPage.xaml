<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PassengerTicketService.Views.TicketPage"
             BackgroundColor="#101010"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- 1. HEADER -->
        <Label Grid.Row="0" 
               Text="Mijn aankopen" 
               TextColor="White" 
               FontSize="22" 
               Margin="20,40,20,15" 
               VerticalOptions="Center" />

        <!-- 2. SCROLLBARE INHOUD -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0,20,30" Spacing="20">

                <!-- TABS (Segmented Control) -->
                <Border BackgroundColor="#1A1A1A" StrokeThickness="0" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*, *" HeightRequest="45">
                        <!-- Actief Tab -->
                        <Border Grid.Column="0" BackgroundColor="#5AA2F0" Margin="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8,0,0,8" />
                            </Border.StrokeShape>
                            <Label Text="Actief" TextColor="Black" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <!-- Archief Tab (Inactief) -->
                        <Label Grid.Column="1" Text="Archief" TextColor="White" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- KAART 1: Heen- en terugreis (Voorbeeld van een retour) -->
                <Border Stroke="#444444" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">
                        <!-- Titel -->
                        <Label Text="Heen- en terugreis" TextColor="White" FontSize="18" FontAttributes="Bold" />
                        <BoxView Color="#444444" HeightRequest="1" HorizontalOptions="Fill" />

                        <!-- Details (Zonder namen en klasse) -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Geldig op 13/10/2026" TextColor="#A0A0A0" FontSize="14" />
                            <Label Text="Gekocht op: 13/10/2026 om 07:57" TextColor="#A0A0A0" FontSize="14" />
                        </VerticalStackLayout>

                        <!-- Route (MOL -> GEEL) -->
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" Margin="0,5,0,5">
                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="0">
                                <Ellipse Fill="#A0A0A0" WidthRequest="14" HeightRequest="14" HorizontalOptions="Center" />
                                <BoxView Color="#A0A0A0" WidthRequest="2" HeightRequest="15" HorizontalOptions="Center" />
                                <Ellipse Fill="Transparent" Stroke="#A0A0A0" StrokeThickness="2" WidthRequest="14" HeightRequest="14" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="13">
                                <Label Text="MOL" TextColor="White" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Text="GEEL" TextColor="White" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView Color="#444444" HeightRequest="1" HorizontalOptions="Fill" />

                        <!-- Heenreis Ticket -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="Heenreis" TextColor="#5AA2F0" FontSize="16" FontAttributes="Bold" />
                                <Label Text="Reis op: 13/10/2026" TextColor="#A0A0A0" FontSize="14" />
                            </VerticalStackLayout>

                            <!-- QR Code Placeholder -->
                            <Border Grid.Column="1" BackgroundColor="Black" Padding="5" WidthRequest="80" HeightRequest="80">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="4" />
                                </Border.StrokeShape>
                                <Grid RowDefinitions="*,*,*,*" ColumnDefinitions="*,*,*,*" RowSpacing="2" ColumnSpacing="2">
                                    <BoxView Grid.Row="0" Grid.Column="0" Color="White" />
                                    <BoxView Grid.Row="0" Grid.Column="3" Color="White" />
                                    <BoxView Grid.Row="3" Grid.Column="0" Color="White" />
                                    <BoxView Grid.Row="1" Grid.Column="1" Color="White" />
                                    <BoxView Grid.Row="2" Grid.Column="2" Color="White" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Terugreis Ticket (Alleen zichtbaar als het een retour is) -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,10,0,0">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="Terugreis" TextColor="#5AA2F0" FontSize="16" FontAttributes="Bold" />
                                <Label Text="Reis op: 13/10/2026" TextColor="#A0A0A0" FontSize="14" />
                            </VerticalStackLayout>

                            <!-- QR Code Placeholder -->
                            <Border Grid.Column="1" BackgroundColor="Black" Padding="5" WidthRequest="80" HeightRequest="80">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="4" />
                                </Border.StrokeShape>
                                <Grid RowDefinitions="*,*,*,*" ColumnDefinitions="*,*,*,*" RowSpacing="2" ColumnSpacing="2">
                                    <BoxView Grid.Row="0" Grid.Column="0" Color="White" />
                                    <BoxView Grid.Row="0" Grid.Column="3" Color="White" />
                                    <BoxView Grid.Row="3" Grid.Column="0" Color="White" />
                                    <BoxView Grid.Row="1" Grid.Column="2" Color="White" />
                                    <BoxView Grid.Row="2" Grid.Column="1" Color="White" />
                                </Grid>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- KAART 2: Enkele reis (Ter demonstratie van de herbruikbaarheid) -->
                <Border Stroke="#444444" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Ticket Elk Moment Jongere" TextColor="White" FontSize="18" FontAttributes="Bold" />
                        <BoxView Color="#444444" HeightRequest="1" HorizontalOptions="Fill" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Geldig op 14/10/2026" TextColor="#A0A0A0" FontSize="14" />
                            <Label Text="Gekocht op: 14/10/2026 om 07:55" TextColor="#A0A0A0" FontSize="14" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" Margin="0,5,0,5">
                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="0">
                                <Ellipse Fill="#A0A0A0" WidthRequest="14" HeightRequest="14" HorizontalOptions="Center" />
                                <BoxView Color="#A0A0A0" WidthRequest="2" HeightRequest="15" HorizontalOptions="Center" />
                                <Ellipse Fill="Transparent" Stroke="#A0A0A0" StrokeThickness="2" WidthRequest="14" HeightRequest="14" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="13">
                                <Label Text="MOL" TextColor="White" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Text="GEEL" TextColor="White" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView Color="#444444" HeightRequest="1" HorizontalOptions="Fill" />

                        <!-- Enkele reis Ticket -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="Enkele reis" TextColor="#5AA2F0" FontSize="16" FontAttributes="Bold" />
                                <Label Text="Reis op: 14/10/2026" TextColor="#A0A0A0" FontSize="14" />
                            </VerticalStackLayout>

                            <Border Grid.Column="1" BackgroundColor="Black" Padding="5" WidthRequest="80" HeightRequest="80">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="4" />
                                </Border.StrokeShape>
                                <Grid RowDefinitions="*,*,*,*" ColumnDefinitions="*,*,*,*" RowSpacing="2" ColumnSpacing="2">
                                    <BoxView Grid.Row="0" Grid.Column="0" Color="White" />
                                    <BoxView Grid.Row="0" Grid.Column="3" Color="White" />
                                    <BoxView Grid.Row="3" Grid.Column="0" Color="White" />
                                    <BoxView Grid.Row="1" Grid.Column="1" Color="White" />
                                    <BoxView Grid.Row="2" Grid.Column="2" Color="White" />
                                </Grid>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 3. BOTTOM NAVIGATIE BALK MET FAB -->
        <Grid Grid.Row="3" VerticalOptions="End" Margin="0,20,0,0">

            <!-- Background Bar -->
            <Border BackgroundColor="#1C1C1E" 
        StrokeThickness="0" 
        HeightRequest="70" 
        VerticalOptions="End">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="25,25,0,0" />
                </Border.StrokeShape>

                <!-- Nav Icons -->
                <Grid ColumnDefinitions="*, *, *" Padding="10,0">
                    <!-- Home (Selected) -->
                    <Path Grid.Column="0"
                  Data="M10,20 L10,14 L14,14 L14,20 L19,20 L19,12 L22,12 L12,3 L2,12 L5,12 L5,20 Z"
                  Fill="White"
                  Aspect="Uniform"
                  WidthRequest="24"
                  HeightRequest="24"
                  HorizontalOptions="Center"
                  VerticalOptions="Center" />

                    <!-- Empty space for FAB -->
                    <BoxView Grid.Column="1" Color="Transparent" BackgroundColor="Transparent"/>

                    <!-- Profile (was Grid.Column="4" → 2) -->
                    <Path Grid.Column="2"
                  Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z"
                  Fill="White"
                  Aspect="Uniform"
                  WidthRequest="24"
                  HeightRequest="24"
                  HorizontalOptions="Center"
                  VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Floating Action Button (Orange) -->
            <Border BackgroundColor="#E86A22"
        StrokeThickness="0"
        WidthRequest="65"
        HeightRequest="65"
        HorizontalOptions="Center"
        VerticalOptions="Start"
        Margin="0,-35,0,0"
        ZIndex="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="32.5" />
                </Border.StrokeShape>

                <Path Data="M22,10 L22,6 C22,4.9 21.1,4 20,4 L4,4 C2.9,4 2.01,4.9 2.01,6 L2,10 C3.1,10 4,10.9 4,12 C4,13.1 3.1,14 2,14 L2,18 C2,19.1 2.9,20 4,20 L20,20 C21.1,20 22,19.1 22,18 L22,14 C20.9,14 20,13.1 20,12 C20,10.9 20.9,10 22,10 Z"
          Fill="White"
          Aspect="Uniform"
          WidthRequest="28"
          HeightRequest="28"
          HorizontalOptions="Center"
          VerticalOptions="Center" />
            </Border>
        </Grid>
    </Grid>
</ContentPage>