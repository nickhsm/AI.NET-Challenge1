<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PassengerTicketService.ViewModels"
             xmlns:components="clr-namespace:PassengerTicketService.Components"
             xmlns:models="clr-namespace:PassengerTicketService.Models"
             x:Class="PassengerTicketService.Views.TicketPage"
             x:DataType="viewModels:ITicketViewModel"
             BackgroundColor="#101010"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- 1. HEADER -->
        <Label Grid.Row="0" 
               Text="Mijn aankopen" 
               TextColor="White" 
               FontSize="22" 
               Margin="20,40,20,15" 
               VerticalOptions="Center" />

        <!-- 2. SCROLLBARE INHOUD (CollectionView) -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding DisplayedTickets}" Margin="20,0,20,20">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="20" Padding="0,0,0,10">

                    <!-- TABS (Segmented Control) -->
                    <Border BackgroundColor="#1A1A1A" StrokeThickness="0" Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*, *" HeightRequest="45">

                            <!-- Actief Tab -->
                            <Border Grid.Column="0" BackgroundColor="{Binding ActiveTabColor}" Margin="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8,0,0,8" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowActiveCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="Actief" TextColor="{Binding ActiveTabTextColor}" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <!-- Archief Tab -->
                            <Border Grid.Column="1" BackgroundColor="{Binding ArchiveTabColor}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="0,8,8,0" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowArchiveCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="Archief" TextColor="{Binding ArchiveTabTextColor}" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <Label Text="Geen tickets gevonden." TextColor="#A0A0A0" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,40,0,0"/>
            </CollectionView.EmptyView>

            <!-- KAART TEMPLATE -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PurchaseDisplayModel">
                    <Border Stroke="#444444" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="15" Margin="0,0,0,20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="12">
                            <!-- Titel -->
                            <Label Text="{Binding Title}" TextColor="White" FontSize="18" FontAttributes="Bold" />
                            <BoxView Color="#444444" HeightRequest="1" HorizontalOptions="Fill" />

                            <!-- Details -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding ExpirationDate, StringFormat='Geldig op {0:dd/MM/yyyy}'}" TextColor="#A0A0A0" FontSize="14" />
                            </VerticalStackLayout>

                            <!-- Route (Gebruikt de eerste ticket voor de stations) -->
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" Margin="0,5,0,5">
                                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="0">
                                    <Ellipse Fill="#A0A0A0" WidthRequest="14" HeightRequest="14" HorizontalOptions="Center" />
                                    <BoxView Color="#A0A0A0" WidthRequest="2" HeightRequest="15" HorizontalOptions="Center" />
                                    <Ellipse Fill="Transparent" Stroke="#A0A0A0" StrokeThickness="2" WidthRequest="14" HeightRequest="14" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="13">
                                    <Label Text="{Binding Tickets[0].StationFrom}" TextColor="White" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Text="{Binding Tickets[0].StationTo}" TextColor="White" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView Color="#444444" HeightRequest="1" HorizontalOptions="Fill" />

                            <!-- Lijst van tickets binnen deze aankoop (Heen / Terug) -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Tickets}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:TicketDisplayModel">
                                        <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,5">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding JourneyType}" TextColor="#5AA2F0" FontSize="16" FontAttributes="Bold" />
                                                <Label Text="{Binding TravelDate, StringFormat='Reis op: {0:dd/MM/yyyy}'}" TextColor="#A0A0A0" FontSize="14" />
                                            </VerticalStackLayout>

                                            <!-- QR Code Placeholder -->
                                            <Border Grid.Column="1" BackgroundColor="Black" Padding="5" WidthRequest="80" HeightRequest="80">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="4" />
                                                </Border.StrokeShape>
                                                <Grid RowDefinitions="*,*,*,*" ColumnDefinitions="*,*,*,*" RowSpacing="2" ColumnSpacing="2">
                                                    <BoxView Grid.Row="0" Grid.Column="0" Color="White" />
                                                    <BoxView Grid.Row="0" Grid.Column="3" Color="White" />
                                                    <BoxView Grid.Row="3" Grid.Column="0" Color="White" />
                                                    <BoxView Grid.Row="1" Grid.Column="1" Color="White" />
                                                    <BoxView Grid.Row="2" Grid.Column="2" Color="White" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 3. BOTTOM NAVIGATIE BALK (Ongewijzigd gelaten) -->
        <components:BottomNavBar Grid.Row="2" SelectedTab="Tickets" />

    </Grid>
</ContentPage>