<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PassengerTicketService.ViewModels"
             x:Class="PassengerTicketService.Views.StartPage"
             x:DataType="viewModels:IStartViewModel"
             BackgroundColor="#101010"
             Shell.NavBarIsVisible="False">



        <!-- 1. CONTENT -->
    <VerticalStackLayout Padding="20,20,20,0" Spacing="20" VerticalOptions="Start">

        <!-- Welkom Titel -->
        <Label Text="Welkom!" 
                   TextColor="White" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   Margin="0,20,0,10" />

        <!-- Subtitel -->
        <Label Text="Meld u aan of maak een account aan om toegang te krijgen tot onze diensten." 
                   TextColor="#A0A0A0" 
                   FontSize="15" 
                   HorizontalTextAlignment="Center" 
                   LineHeight="1.3" 
                   Margin="10,0,10,20" />

        <!-- Aanmelden Knop (Oranje) -->
        <Button Text="Aanmelden" 
                    Command="{Binding LoginCommand}"
                    BackgroundColor="#E86A22" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    FontSize="16"
                    CornerRadius="8" 
                    HeightRequest="55" />

        <!-- Account aanmaken Knop (Blauwe Rand) -->
        <Border Stroke="#5AA2F0" 
                    StrokeThickness="2" 
                    BackgroundColor="Transparent" 
                    HeightRequest="55"
                    Margin="0,5,0,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding NavigateRegisterCommand}" />
            </Border.GestureRecognizers>
            <Label Text="Account aanmaken" 
                       TextColor="#5AA2F0" 
                       FontAttributes="Bold" 
                       FontSize="16" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" />
        </Border>

    </VerticalStackLayout>
</ContentPage>