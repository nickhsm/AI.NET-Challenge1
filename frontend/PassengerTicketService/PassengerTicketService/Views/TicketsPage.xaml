<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PassengerTicketService.Views.TicketsPage"
    Title="TicketsPage"
             BackgroundColor="#101010"
             Shell.NavBarIsVisible="False">

    <!-- Hoofd Grid: Header (Auto), Content (*), Nav Bar (Auto) -->
    <Grid RowDefinitions="Auto, *, Auto">

        <!-- 1. HEADER -->
        <Label Grid.Row="0" 
               Text="Mijn aankopen" 
               TextColor="White" 
               FontSize="22" 
               Margin="20,40,20,15" 
               VerticalOptions="Center" />

        <!-- 2. SCROLLBARE INHOUD -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0,20,30" Spacing="20">

                <!-- TABS (Segmented Control) -->
                <Border BackgroundColor="#1A1A1A" StrokeThickness="0" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*, *, *" HeightRequest="45">
                        <Label Grid.Column="0" Text="Actief" TextColor="White" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Vouchers" TextColor="White" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />

                        <!-- Actieve Tab (Archief) -->
                        <Border Grid.Column="2" BackgroundColor="#5AA2F0" Margin="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Label Text="Archief" TextColor="Black" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- KAART 1: Ticket Elk Moment Jongere -->
                <Border Stroke="#444444" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">
                        <!-- Titel -->
                        <Label Text="Ticket Elk Moment Jongere" TextColor="White" FontSize="18" FontAttributes="Bold" />
                        <BoxView Color="#444444" HeightRequest="1" HorizontalOptions="Fill" />

                        <!-- Namen -->
                        <Grid ColumnDefinitions="*, *">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Voornaam:" TextColor="#A0A0A0" FontSize="14" />
                                <Label Text="JONATHAN" TextColor="White" FontSize="15" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Achternaam:" TextColor="#A0A0A0" FontSize="14" />
                                <Label Text="YANG" TextColor="White" FontSize="15" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Details en QR Code -->
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <!-- Tekst Details -->
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <Label Text="Geldig op 14/10/2026, 2e klas, enkele reis" TextColor="#A0A0A0" FontSize="14" LineBreakMode="WordWrap" />
                                <Label Text="Gekocht op:" TextColor="#A0A0A0" FontSize="14" Margin="0,5,0,0" />
                                <Label Text="14/10/2026 om 07:55" TextColor="#A0A0A0" FontSize="14" />

                                <Label Text="Minder details ⌃" TextColor="White" FontSize="14" TextDecorations="Underline" Margin="0,10,0,0" />

                                <Label Text="Productcode: A2" TextColor="#A0A0A0" FontSize="14" Margin="0,5,0,0" />
                                <Label Text="Nummer: L4S4JYLS-001" TextColor="#A0A0A0" FontSize="14" />
                            </VerticalStackLayout>

                            <!-- QR Code Placeholder -->
                            <Border Grid.Column="1" BackgroundColor="Black" Padding="5" WidthRequest="90" HeightRequest="90" VerticalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="4" />
                                </Border.StrokeShape>
                                <!-- Simulatie van QR Code met een Grid -->
                                <Grid RowDefinitions="*,*,*,*" ColumnDefinitions="*,*,*,*" RowSpacing="2" ColumnSpacing="2">
                                    <BoxView Grid.Row="0" Grid.Column="0" Color="White" />
                                    <BoxView Grid.Row="0" Grid.Column="3" Color="White" />
                                    <BoxView Grid.Row="3" Grid.Column="0" Color="White" />
                                    <BoxView Grid.Row="1" Grid.Column="1" Color="White" />
                                    <BoxView Grid.Row="2" Grid.Column="2" Color="White" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Route (MOL -> GEEL) -->
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" Margin="0,10,0,0">
                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="0">
                                <Ellipse Fill="#A0A0A0" WidthRequest="14" HeightRequest="14" HorizontalOptions="Center" />
                                <BoxView Color="#A0A0A0" WidthRequest="2" HeightRequest="15" HorizontalOptions="Center" />
                                <Ellipse Fill="Transparent" Stroke="#A0A0A0" StrokeThickness="2" WidthRequest="14" HeightRequest="14" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="13">
                                <Label Text="MOL" TextColor="White" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Text="GEEL" TextColor="White" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Separator -->
                        <BoxView Color="#444444" HeightRequest="1" HorizontalOptions="Fill" Margin="0,5,0,5" />

                        <!-- Opnieuw Kopen Button (Outlined) -->
                        <Border Stroke="#5AA2F0" StrokeThickness="2" BackgroundColor="Transparent" HeightRequest="45">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6" />
                            </Border.StrokeShape>
                            <Label Text="Opnieuw kopen" TextColor="#5AA2F0" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- KAART 2: Heen- en terugreis (Gedeeltelijk zichtbaar) -->
                <Border Stroke="#444444" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Heen- en terugreis" TextColor="White" FontSize="18" FontAttributes="Bold" />
                        <BoxView Color="#444444" HeightRequest="1" HorizontalOptions="Fill" />

                        <Grid ColumnDefinitions="*, *">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Voornaam:" TextColor="#A0A0A0" FontSize="14" />
                                <Label Text="JONATHAN" TextColor="White" FontSize="15" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Achternaam:" TextColor="#A0A0A0" FontSize="14" />
                                <Label Text="YANG" TextColor="White" FontSize="15" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>

                        <Label Text="Geldig op 13/10/2026, 2e klas, rondreis" TextColor="#A0A0A0" FontSize="14" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 3. BOTTOM NAVIGATIE BALK MET FAB -->
        <Grid Grid.Row="2" VerticalOptions="End">

            <!-- Achtergrond van de Nav Bar -->
            <Border BackgroundColor="#1C1C1E" StrokeThickness="0" HeightRequest="75" VerticalOptions="End">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="25,25,0,0" />
                </Border.StrokeShape>

                <!-- Iconen (Gebruik echte afbeeldingen/iconen in je project) -->
                <Grid ColumnDefinitions="*, *, *, *, *" Padding="10,0">
                    <!-- Home -->
                    <Label Grid.Column="0" Text="🏠" TextColor="White" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                    <!-- Star -->
                    <Label Grid.Column="1" Text="☆" TextColor="White" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                    <!-- Leeg midden voor FAB -->
                    <BoxView Grid.Column="2" Color="Transparent" />
                    <!-- Ticket (Actief, blauw) -->
                    <Label Grid.Column="3" Text="🎫" TextColor="#5AA2F0" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                    <!-- Profile -->
                    <Label Grid.Column="4" Text="👤" TextColor="White" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Roze Floating Action Button (Winkelwagen) -->
            <Border BackgroundColor="#F04482" WidthRequest="65" HeightRequest="65" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,-32,0,0" ZIndex="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="32.5" />
                </Border.StrokeShape>
                <Label Text="🛍" TextColor="White" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

        </Grid>

    </Grid>
</ContentPage>