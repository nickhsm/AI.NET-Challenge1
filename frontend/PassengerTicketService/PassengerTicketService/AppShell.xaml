<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PassengerTicketService.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PassengerTicketService.Views"
    Title="PassengerTicketService"
    FlyoutBehavior="Disabled">

    <ShellContent
        Title="Welkom"
        ContentTemplate="{DataTemplate views:StartPage}"
        Route="StartPage" />

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate views:HomePage}"
        Route="HomePage" />

    <ShellContent
        Title="Tickets"
        ContentTemplate="{DataTemplate views:TicketPage}"
        Route="TicketPage" />

    <ShellContent 
        Title="Profile" 
        ContentTemplate="{DataTemplate views:ProfilePage}" 
        Route="ProfilePage" />

</Shell>
