<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PassengerTicketService.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PassengerTicketService.Views"
    Title="PassengerTicketService">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate views:StartPage}"
        Route="MainPage" />

    <ShellContent 
        Title="Home" 
        ContentTemplate="{DataTemplate views:HomePage}" 
        Route="HomePage" />

    <ShellContent 
        Title="Tickets" 
        ContentTemplate="{DataTemplate views:TicketPage}" 
        Route="TicketPage" />

</Shell>
