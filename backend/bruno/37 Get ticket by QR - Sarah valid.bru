meta {
  name: Get ticket by QR - Sarah valid
  type: http
  seq: 37
}

get {
  url: {{baseUrl}}/api/ticket/qr/{{sarahValidQr}}
  body: none
  auth: inherit
}

script:post-response {
  // The conductor app consumes a ticket by the id it gets from the QR lookup. Do the same here.
  if (res.getStatus() === 200) {
    bru.setVar("sarahTicketId", res.getBody().id);
  }
}

tests {
  test("200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("not used yet", function() {
    expect(res.getBody().used).to.equal(false);
  });
}
