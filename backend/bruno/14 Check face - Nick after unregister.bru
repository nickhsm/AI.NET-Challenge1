meta {
  name: Check face - Nick after unregister
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/passenger/check-face
  body: multipartForm
  auth: none
}

body:multipart-form {
  photo: @file(images/nick.jpg)
}
tests {
  test("404 face is no longer known", function() {
    expect(res.getStatus()).to.equal(404);
  });
}
