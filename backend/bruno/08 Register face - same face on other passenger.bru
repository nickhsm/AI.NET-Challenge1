meta {
  name: Register face - same face on other passenger
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/passenger/me/face
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  photo: @file(images/nick.jpg)
}
tests {
  test("409 face already used by another account", function() {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody()).to.contain("another account");
  });
}
