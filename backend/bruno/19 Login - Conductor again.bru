meta {
  name: Login - Conductor again
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/api/auth/conductor/login
  body: json
  auth: none
}

body:json {
  {
    "email": "conductor@test.be",
    "password": "password"
  }
}

script:post-response {
  // Every request after this one sends this token (see collection.bru).
  bru.setVar("token", res.getStatus() === 200 ? res.getBody().token : "");
}

tests {
  test("200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
