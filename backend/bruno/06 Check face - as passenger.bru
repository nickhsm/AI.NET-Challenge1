meta {
  name: Check face - as passenger
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/passenger/check-face
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  photo: @file(images/nick.jpg)
}
tests {
  test("403 a passenger may not use conductor endpoints", function() {
    expect(res.getStatus()).to.equal(403);
  });
}
