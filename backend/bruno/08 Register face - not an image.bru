meta {
  name: Register face - not an image
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/passenger/{{sarahPassengerId}}/face
  body: multipartForm
  auth: none
}

body:multipart-form {
  photo: @file(images/not-an-image.txt)
}
tests {
  test("415 wrong file type", function() {
    expect(res.getStatus()).to.equal(415);
  });
}
