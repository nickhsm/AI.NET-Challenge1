meta {
  name: Check face - Nick
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/passenger/check-face
  body: multipartForm
  auth: none
}

body:multipart-form {
  photo: @file(images/nick.jpg)
}
tests {
  test("200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("finds the right passenger", function() {
    const body = res.getBody();
    expect(body.firstName).to.equal("Nick");
    expect(body.facePersonId).to.equal(bru.getVar("nickFacePersonId"));
  });

  test("Nick has a valid ticket today (seed data)", function() {
    expect(res.getBody().hasTickets).to.equal(true);
  });
}
