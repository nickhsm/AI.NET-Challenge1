meta {
  name: Get ticket by QR - Nick used
  type: http
  seq: 35
}

get {
  url: {{baseUrl}}/api/ticket/qr/{{nickUsedQr}}
  body: none
  auth: inherit
}

tests {
  test("200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("shows the ticket is already used", function() {
    expect(res.getBody().used).to.equal(true);
  });
}
