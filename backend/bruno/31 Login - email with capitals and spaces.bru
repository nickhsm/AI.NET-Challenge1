meta {
  name: Login - email with capitals and spaces
  type: http
  seq: 31
}

post {
  url: {{baseUrl}}/api/auth/passenger/login
  body: json
  auth: none
}

body:json {
  {
    "email": " Nick@Test.BE ",
    "password": "password"
  }
}

tests {
  test("200 email is trimmed and lowercased", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
