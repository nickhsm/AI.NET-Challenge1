meta {
  name: Login - wrong password
  type: http
  seq: 29
}

post {
  url: {{baseUrl}}/api/auth/passenger/login
  body: json
  auth: none
}

body:json {
  {
    "email": "nick@test.be",
    "password": "wrong"
  }
}

script:post-response {
  bru.setVar("loginErrorMessage", res.getBody());
}

tests {
  test("401 wrong password", function() {
    expect(res.getStatus()).to.equal(401);
  });
}
